{
	"name": "beryl-docs",
	"version": "0.0.1",
	"private": true,
	"bugs": "https://github.com/tylerbutler/beryl/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tylerbutler/beryl.git",
		"directory": "website"
	},
	"license": "MIT",
	"author": "Tyler Butler <tyler@tylerbutler.com>",
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"astro": "astro",
		"build:interactive": "cd interactive && gleam build --target javascript",
		"build:site": "pnpm run generate:og && pnpm run build:interactive && astro build",
		"check:astro": "pnpm run build:interactive && astro check",
		"check:snippets": "node scripts/check-snippets.mjs",
		"clean": "rimraf dist *.tsbuildinfo *.done.build.log .astro",
		"dev": "astro dev",
		"generate:og": "node scripts/generate-og-image.mjs",
		"generate:reference": "node scripts/generate-reference.mjs",
		"preview": "astro preview",
		"start": "astro dev",
		"test:interactive": "cd interactive && gleam test --target javascript",
		"test:reference": "node --test scripts/generate-reference.test.mjs",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/starlight": "^0.41.7",
		"@fontsource-variable/hanken-grotesk": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/unbounded": "^5.3.0",
		"astro": "^7.2.0",
		"astro-mermaid": "^2.1.0",
		"astro-tinylytics": "^0.1.0",
		"mermaid": "^11.16.1",
		"phoenix": "^1.8.9",
		"sharp": "^0.35.3",
		"starlight-links-validator": "^0.24.1",
		"starlight-llms-txt": "^0.11.0",
		"typescript": "~6.0.0"
	},
	"devDependencies": {
		"@fec/remark-a11y-emoji": "^4.0.2",
		"@playwright/test": "^1.61.1",
		"rimraf": "^6.1.3"
	}
}
