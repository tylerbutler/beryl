	},
	"license": "MIT",
	"author": "Tyler Butler <tyler@tylerbutler.com>",
	"type": "module",
	"packageManager": "pnpm@10.15.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"astro": "astro",
		"build:site": "pnpm run generate:og && astro build",
		"check:astro": "astro check",
		"clean": "rimraf dist *.tsbuildinfo *.done.build.log .astro",
		"dev": "astro dev",
		"generate:og": "node scripts/generate-og-image.mjs",
		"generate:reference": "node scripts/generate-reference.mjs",
		"preview": "astro preview",
		"start": "astro dev",
		"test:reference": "node --test scripts/generate-reference.test.mjs"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.6",
		"@astrojs/starlight": "^0.39.1",
		"@fontsource-variable/hanken-grotesk": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/unbounded": "^5.2.8",
		"astro": "^6.4.6",
		"astro-mermaid": "^2.1.0",
		"astro-tinylytics": "^0.1.0",
		"mermaid": "^11.16.0",
		"sharp": "^0.35.0",
		"starlight-links-validator": "^0.24.0",
		"starlight-llms-txt": "^0.8.1",
		"typescript": "~5.9.3"
	},
