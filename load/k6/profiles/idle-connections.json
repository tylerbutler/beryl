{
  "name": "idle-connections",
  "exec": "idleConnections",
  "executor": {
    "executor": "constant-vus",
    "vus": 10,
    "duration": "1m",
    "gracefulStop": "15s"
  },
  "thresholds": {
    "checks": ["rate==1"],
    "phoenix_scenario_operation_rate": ["rate==1"],
    "phoenix_client_errors": ["count==0"],
    "phoenix_unexpected_client_errors": ["count==0"],
    "phoenix_protocol_errors": ["count==0"],
    "phoenix_decode_errors": ["count==0"],
    "phoenix_ws_failure_rate": ["rate==0"],
    "phoenix_join_rejection_rate": ["rate==0"],
    "phoenix_heartbeat_timeout_rate": ["rate==0"]
  },
  "parameters": {
    "TOPIC": "bench:idle",
    "SESSION_DURATION_MS": 61000
  }
}
